{
  "manifest_version": 2,
  "name": "Video Grabber",
  "version": "1.0.1",
  "description": "Detects videos played on a page and lets you download them (direct files and unencrypted HLS streams).",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "tabs"
  ],
  "background": {
    "scripts": ["vendor/mux-mp4.min.js", "lib/formats.js", "lib/remux.js", "background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Video Grabber",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{3d1d20ec-b52a-40ea-8255-8ee3b9c8cea6}",
      "strict_min_version": "142.0",
      "update_url": "https://github.com/kharam1436/video-grabber/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
